      propertyPath: m_AnchoredPosition.x
      value: -600
      objectReference: {fileID: 0}
    - target: {fileID: 6715514986418929216, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -452
      objectReference: {fileID: 0}
    - target: {fileID: 6715514986418929216, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_LocalEulerAnglesHint.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6715514986418929216, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6715514986418929216, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8381803997503107674, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_text
      value: "A lone ronin, considered the greatest warrior of the warring ages.\r\n\r\nFrom
        the moment he first gripped a blade at nine years old, Fraug has walked the
        path of steel and blood; with over sixty duels fought, he never suffered
        a single defeat to his name. Yet for all his unmatched renown, he is never
        still. After every victory, he turns inward, dissecting each movement, perfecting
        each breath, shaping himself into something greater.\r\n\r\nFraug\u2019s
        true strength, however, is not in his skills with a blade, though many would
        swear it is unmatched, but in the unseen battlefield of the mind. His composure
        under mortal threat, his razor-edged awareness, and his uncanny insight into
        the hearts of people allow him to claim victory before the first strike is
        ever made.\r\n\r\nThose who would challenge him, beware: one misstep before
        this green-clad amphibian, and your story ends."
      objectReference: {fileID: 0}
    - target: {fileID: 8381803997503107674, guid: ecb50d97091b9c54cae541f86a929a07, type: 3}
      propertyPath: m_fontSize
      value: 21.65
